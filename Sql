SELECT TOP (:batchSize)
    ips.REQUEST_ID,
    ips.REQUEST_SYSTEM,
    ips.ORIGINAL_REQUEST,
    ips.STATUS,
    ips.CREATED_TS,
    fd.FRAUD_DECISION_ID,
    fd.FRAUD_SYSTEM,
    fd.FRAUD_CASE_ID,
    fd.FRAUD_DECISION,
    fd.FRAUD_CHECK_SCORE,
    fd.ADDITIONAL_INFO_1,
    fd.ADDITIONAL_INFO_2
FROM payment.INCOMING_PAYMENT_STATUS ips WITH (UPDLOCK, READPAST)
LEFT JOIN PAYMENT.FRAUD_DECISION fd
    ON fd.SOURCE_TRANSACTION_ID = ips.REQUEST_ID
WHERE ips.STATUS = 'PENDING'
AND NOT EXISTS (
    SELECT 1 FROM payment.INCOMING_PAYMENT_STATUS terminal
    WHERE terminal.REQUEST_ID = ips.REQUEST_ID
    AND terminal.STATUS IN ('RESPONDED', 'AUTO_APPROVED')
)
ORDER BY ips.CREATED_TS ASC;

